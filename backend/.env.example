PORT=3000

# MongoDB Atlas connection string (free M0 cluster). The server starts fine
# without this set -- gameplay (rooms/moves) still works, only match history
# and everything under /auth (signup/login/guest) need it (see
# src/config/db.js and src/middleware/auth.middleware.js#requireDatabase).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/partner_game?retryWrites=true&w=majority

# Secret used to sign login/session tokens. Falls back to an insecure dev
# value if unset -- MUST be set to a long random value before deploying
# anywhere real (see src/utils/jwt.js).
JWT_SECRET=

# Comma-separated list of allowed origins for the Flutter app / Socket.IO
# client. Use * only for local development.
CORS_ORIGIN=*

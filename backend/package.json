{
  "name": "partner-game-backend",
  "version": "1.0.0",
  "description": "Real-time backend for the Partner Game platform: Socket.IO game rooms with server-authoritative move validation, plus MongoDB match history.",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:local-db": "node --watch dev-local-db.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2"
  }
}
